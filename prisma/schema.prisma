// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// =============================================================================
// PRISMA CONFIGURATION
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "mysql"
}

// =============================================================================
// ENUMS DEFINITION
// =============================================================================

enum Status {
  ACTIVE
  INACTIVE
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum CycleType {
  ANNUAL
  QUARTERLY
}

enum ObjectiveLevel {
  COMPANY
  DEPARTMENT
  INDIVIDUAL
}

enum ConfidenceScore {
  LOW
  MEDIUM
  HIGH
}

enum AlignmentType {
  VERTICAL
  CROSS
}

enum UnitType {
  PERCENTAGE
  CURRENCY
  NUMERIC
  BOOLEAN
}

// =============================================================================
// 1. DEPARTMENTS
// =============================================================================

model Department {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(150)
  description String?   @db.Text
  parentId    BigInt?   @map("parent_id")
  managerId   BigInt?   @map("manager_id")
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  parent           Department?  @relation("DeptParentToDeptChild", fields: [parentId], references: [id], onDelete: SetNull)
  children         Department[] @relation("DeptParentToDeptChild")
  manager          User?        @relation("DeptManager", fields: [managerId], references: [id], onDelete: SetNull)
  members          User[]       @relation("UserDepartment")
  departmentObjectives Objective[]

  @@index([status], map: "idx_dept_status")
  @@index([parentId], map: "idx_dept_parent")
  @@index([managerId], map: "idx_dept_manager") // 💡 REFACTORED: Tối ưu query tìm phòng ban do Manager X quản lý
  @@map("departments")
}

// =============================================================================
// 2. USERS
// =============================================================================

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique @db.VarChar(150)
  password     String    @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(550)
  jobTitle     String?   @map("job_title") @db.VarChar(100)
  departmentId BigInt?   @map("department_id")
  managerId    BigInt?   @map("manager_id")
  status       Status    @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  department         Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  manager            User?       @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       User[]      @relation("UserManager")
  managedDepartments Department[] @relation("DeptManager")

  createdCycles       Cycle[]     @relation("CycleCreator")
  ownedObjectives     Objective[] @relation("ObjOwner")
  approvedObjectives  Objective[] @relation("ObjApprover")
  ownedKeyResults     KeyResult[] @relation("KROwner")
  
  createdCheckIns     CheckIn[]   @relation("CheckInCreator")
  reviewedCheckIns    CheckIn[]   @relation("CheckInReviewer")

  refreshTokens RefreshToken[]
  roles         UserRole[]

  @@index([departmentId], map: "idx_user_dept")
  @@index([managerId], map: "idx_user_manager") // 💡 REFACTORED: Tối ưu query lấy danh sách nhân viên cấp dưới
  @@index([email], map: "idx_user_email")
  @@index([status], map: "idx_user_status")   // 💡 REFACTORED: Tối ưu query lọc Active Users

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @map("hashed_token")
  userId      BigInt   @map("user_id")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_token_user_id")
  @@index([expiresAt, isRevoked], map: "idx_token_cleanup") // 💡 REFACTORED: Tối ưu Cronjob dọn dẹp Token hết hạn
  @@map("refresh_tokens")
}

// =============================================================================
// 3. DYNAMIC RBAC (5-TABLE ARCHITECTURE - REFACTORED)
// =============================================================================

model Role {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)  // VD: 'SUPER_ADMIN', 'DEPARTMENT_HEAD'
  name        String    @db.VarChar(100)        // VD: 'Quản trị viên hệ thống'
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system") // 💡 REFACTORED: Khóa bảo vệ Role hệ thống không bị xóa lỡ tay
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")      // 💡 REFACTORED: Soft delete giữ nguyên Audit Log

  // Relations
  users       UserRole[]
  permissions RolePermission[]

  @@index([code], map: "idx_role_code")
  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(100) // 💡 REFACTORED: Mã duy nhất dạng 'objective:create' cho Redis Guard
  action      String   @db.VarChar(50)          // CASL support: 'create', 'read', 'update', 'delete'
  subject     String   @db.VarChar(50)          // CASL support: 'User', 'Objective', 'Department'
  module      String   @default("system") @db.VarChar(50) // 💡 REFACTORED: Gom nhóm Module hiển thị UI Dashboard
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  roles       RolePermission[]

  @@unique([action, subject], map: "uq_permission_action_subject")
  @@index([code], map: "idx_permission_code")
  @@index([module], map: "idx_permission_module")
  @@map("permissions")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_role_role_id") // 💡 REFACTORED: Tối ưu B-Tree Reverse Lookup O(log N)
  @@map("user_roles")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "idx_role_permission_perm_id") // 💡 REFACTORED: Tối ưu B-Tree Reverse Lookup O(log N)
  @@map("role_permissions")
}

// =============================================================================
// 4. CYCLES
// =============================================================================

model Cycle {
  id        BigInt    @id @default(autoincrement())
  title     String    @db.VarChar(100)
  code      String    @unique @db.VarChar(50)
  type      CycleType @default(QUARTERLY)
  parentId  BigInt?   @map("parent_id")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  status    Status    @default(DRAFT)
  createdBy BigInt    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  parent   Cycle?    @relation("CycleParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Cycle[]   @relation("CycleParent")
  creator  User      @relation("CycleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  objectives Objective[]

  @@index([status, startDate, endDate], map: "idx_cycle_status_dates")
  @@index([createdBy], map: "idx_cycle_created_by") // 💡 REFACTORED
  @@map("cycles")
}

// =============================================================================
// 5. OBJECTIVES
// =============================================================================

model Objective {
  id                 BigInt         @id @default(autoincrement())
  title              String         @db.VarChar(255)
  description        String?        @db.Text
  level              ObjectiveLevel
  cycleId            BigInt         @map("cycle_id")
  departmentId       BigInt?        @map("department_id")
  ownerId            BigInt         @map("owner_id")
  approverId         BigInt?        @map("approver_id")
  status             Status         @default(DRAFT)
  progressPercentage Decimal        @default(0.00) @map("progress_percentage") @db.Decimal(5, 2)
  confidenceScore    ConfidenceScore @default(MEDIUM) @map("confidence_score")
  weight             Decimal        @default(1.00) @db.Decimal(5, 2)
  isAlignedCross     Boolean        @default(false) @map("is_aligned_cross")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  // Relations
  cycle      Cycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner      User        @relation("ObjOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  approver   User?       @relation("ObjApprover", fields: [approverId], references: [id], onDelete: SetNull)

  keyResults KeyResult[]

  // Alignments (Many-to-Many self reference via join table)
  alignmentsFrom ObjectiveAlignment[] @relation("AlignedFrom")
  alignmentsTo   ObjectiveAlignment[] @relation("AlignedTo")

  @@index([cycleId, departmentId], map: "idx_obj_cycle_dept")
  @@index([ownerId], map: "idx_obj_owner")
  @@index([approverId], map: "idx_obj_approver") // 💡 REFACTORED: Tối ưu query duyệt Objective
  @@index([status], map: "idx_obj_status")
  @@map("objectives")
}

// =============================================================================
// 5.1 OBJECTIVE ALIGNMENTS
// =============================================================================

model ObjectiveAlignment {
  id               BigInt        @id @default(autoincrement())
  alignedFromObjId BigInt        @map("aligned_from_obj_id")
  alignedToObjId   BigInt        @map("aligned_to_obj_id")
  alignmentType    AlignmentType @default(VERTICAL) @map("alignment_type")
  createdAt        DateTime      @default(now()) @map("created_at")

  // Relations
  alignedFrom Objective @relation("AlignedFrom", fields: [alignedFromObjId], references: [id], onDelete: Cascade)
  alignedTo   Objective @relation("AlignedTo", fields: [alignedToObjId], references: [id], onDelete: Cascade)

  @@unique([alignedFromObjId, alignedToObjId], map: "uq_alignment_pair")
  @@index([alignedToObjId], map: "idx_alignment_to_obj") // 💡 REFACTORED: B-Tree Index cho truy vấn Alignment ngược
  @@map("objective_alignments")
}

// =============================================================================
// 6. KEY RESULTS
// =============================================================================

model KeyResult {
  id           BigInt    @id @default(autoincrement())
  objectiveId  BigInt    @map("objective_id")
  title        String    @db.VarChar(255)
  ownerId      BigInt    @map("owner_id")
  unitType     UnitType  @default(NUMERIC) @map("unit_type")
  unitLabel    String?   @map("unit_label") @db.VarChar(50)
  startValue   Decimal   @default(0.00) @map("start_value") @db.Decimal(15, 2)
  targetValue  Decimal   @map("target_value") @db.Decimal(15, 2)
  currentValue Decimal   @default(0.00) @map("current_value") @db.Decimal(15, 2)
  weight       Decimal   @default(1.00) @db.Decimal(5, 2)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner     User      @relation("KROwner", fields: [ownerId], references: [id], onDelete: Restrict)

  checkIns CheckIn[]

  @@index([objectiveId], map: "idx_kr_objective")
  @@index([ownerId], map: "idx_kr_owner")
  @@map("key_results")
}

// =============================================================================
// 7. CHECK-INS
// =============================================================================

model CheckIn {
  id               BigInt          @id @default(autoincrement())
  krId             BigInt          @map("kr_id")
  createdBy        BigInt          @map("created_by")
  oldValue         Decimal         @map("old_value") @db.Decimal(15, 2)
  newValue         Decimal         @map("new_value") @db.Decimal(15, 2)
  confidenceScore  ConfidenceScore @default(MEDIUM) @map("confidence_score")
  note             String?         @db.Text
  blocker          String?         @db.Text
  status           Status          @default(APPROVED)
  reviewerId       BigInt?         @map("reviewer_id")
  reviewerFeedback String?         @map("reviewer_feedback") @db.Text
  approvedDoneAt   DateTime?       @map("approved_done_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  keyResult KeyResult @relation(fields: [krId], references: [id], onDelete: Cascade)
  creator   User      @relation("CheckInCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewer  User?     @relation("CheckInReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([krId, createdAt(sort: Desc)], map: "idx_checkin_kr_created")
  @@index([createdBy], map: "idx_checkin_creator")   // 💡 REFACTORED: Query lịch sử check-in của cá nhân
  @@index([reviewerId], map: "idx_checkin_reviewer") // 💡 REFACTORED: Query danh sách check-in chờ review
  @@index([status], map: "idx_checkin_status")
  @@map("check_ins")
}